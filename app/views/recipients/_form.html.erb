<%= form_for @recipient do |f| %>
  <% if @recipient.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% @recipient.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, "名前" %>
    <%= f.text_field :name, class: "form-control", placeholder: "山田 太郎" %>
  </div>

  <div class="form-group">
    <%= f.label :email, "メールアドレス" %>
    <%= f.email_field :email, class: "form-control", placeholder: "example@email.com" %>
  </div>

  <%= f.submit "保存", class: "btn btn-primary" %>
<% end %>
